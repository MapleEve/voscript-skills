{
  "name": "voscript-skills",
  "version": "1.2.8",
  "description": "VoScript API skill package for AI agents — agent-agnostic helpers for transcription, voiceprint management, and export",
  "keywords": [
    "voscript",
    "claude",
    "skills",
    "ai-agent",
    "transcription",
    "voiceprint"
  ],
  "homepage": "https://github.com/MapleEve/voscript-skills",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapleEve/voscript-skills.git"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Maple (MapleEve)",
  "bin": {
    "voscript-skills": "bin/install.js"
  },
  "scripts": {
    "public-scan": "python voscript-api/scripts/public_release_scan.py --root .",
    "test": "python -m unittest discover -s tests -v",
    "pack:dry": "npm pack --dry-run --json"
  },
  "files": [
    "bin/install.js",
    "voscript-api/.meta.json",
    "voscript-api/SKILL.md",
    "voscript-api/references/*.md",
    "voscript-api/scripts/*.py",
    "LICENSE",
    "README.md",
    "README.zh.md"
